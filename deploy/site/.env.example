# Documentation examples only. Do not use this file as a production default.
# Single configuration owner: deploy/site/runtime.json, validated by SiteConfig.
# tests/manual/site_deployment.py prepare derives the release .env from that JSON.
# This standalone web has no credentials and must not receive core secret env files.
SITE_IMAGE=nginx@sha256:<verified-digest-from-runtime-json>
SITE_PORT=18080
SITE_CONTAINER_PORT=8080
SITE_UID=101
SITE_GID=101
SITE_MEMORY_MIB=96
SITE_CPUS=0.35
SITE_PIDS_LIMIT=64
SITE_TMPFS_MIB=16
SITE_TEMP_PATH=/tmp
SITE_EXTERNAL_NETWORK=example-core_edge
SITE_HEALTH_INTERVAL_SECONDS=20
SITE_HEALTH_TIMEOUT_SECONDS=5
SITE_HEALTH_RETRIES=3
SITE_RELEASE_DIR=/srv/example/site-releases/example-site-01
