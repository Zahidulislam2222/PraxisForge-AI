# Fictional development values. Verify all networks/ports before allocation.
PRAXIS_DATABASE_URL=postgresql://praxis:test-password@127.0.0.1:5432/praxis
PRAXIS_ORIGIN=http://127.0.0.1:4320
PRAXIS_ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
PRAXIS_ADMIN_EMAIL=owner@example.test
PRAXIS_ADMIN_PASSWORD=test-password-for-local-only
PRAXIS_WORKSPACE_NAME=Owner workspace
PRAXIS_MODEL_URL=http://127.0.0.1:11434/v1
PRAXIS_MODEL_ID=configure-a-tested-local-model
PRAXIS_HERMES_REVISION=30463589eb54fa0f48724594cc0e98e6b995729b
PRAXIS_RUNTIME_DIR=backend/runtime
PRAXIS_PROMPTS_FILE=backend/data/prompts.json
PRAXIS_API_PREFIX=/api
PRAXIS_COOKIE_NAME=praxis-session-local
PRAXIS_CSRF_COOKIE_NAME=praxis-csrf-local
PRAXIS_COOKIE_SECURE=false
PRAXIS_SESSION_SECONDS=28800
PRAXIS_LOGIN_WINDOW_SECONDS=900
PRAXIS_LOGIN_MAX_ATTEMPTS=10
PRAXIS_MAX_HTTP_BODY_BYTES=262144
PRAXIS_MAX_DOCUMENT_CHARS=50000
PRAXIS_MAX_REQUEST_CHARS=4000
PRAXIS_CONTEXT_CHARS=9000
PRAXIS_RETRIEVAL_LIMIT=5
PRAXIS_QUEUE_LIMIT=20
PRAXIS_LEASE_SECONDS=180
PRAXIS_POLL_SECONDS=3
PRAXIS_MAX_ATTEMPTS=2
PRAXIS_RUN_SECONDS=180
PRAXIS_MAX_MODEL_TOKENS=1200
PRAXIS_MAX_ITERATIONS=2
PRAXIS_APPROVAL_SECONDS=3600
PRAXIS_HTTP_TIMEOUT_SECONDS=15
PRAXIS_PROVIDER=custom
PRAXIS_PROVIDER_KEY=test-key
PRAXIS_TEMPERATURE=0.1
PRAXIS_API_HOST=0.0.0.0
PRAXIS_API_PORT=8081
PRAXIS_THINKING=false
PRAXIS_HISTORY_LIMIT=100

# DeploymentSettings: consumed by Compose/release preparation, not injected into application processes.
PRAXIS_CORE_IMAGE=praxisforge-core:configure-release
PRAXIS_DB_IMAGE=postgres@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722
