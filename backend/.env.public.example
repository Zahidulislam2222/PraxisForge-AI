PRAXIS_RELEASE_DIR=./release
PRAXIS_SUBNET=10.200.10.0/28
PRAXIS_PRIVATE_SUBNET=10.200.10.16/28
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test-database-bootstrap-password
